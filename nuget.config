<?xml version="1.0" encoding="utf-8"?>
<!--
  Восстановление пакетов офлайн.

  Проблема: единственный включённый источник - nuget.org, и когда он недоступен,
  `dotnet build` висит на "Determining projects to restore" минутами, пока
  NuGet ждёт таймаута HTTP.

  Оба пакета (Exiled.Dev.References 1.0.4 и ExMod.Exiled 9.14.2) заданы точными
  версиями и уже лежат в глобальном кеше (%UserProfile%\.nuget\packages), поэтому
  сеть для сборки не нужна вообще. <clear /> убирает все удалённые источники:
  restore разрешает пакеты из кеша и не делает ни одного запроса.

  Если однажды понадобится добавить новый пакет, верните nuget.org на время:
      dotnet restore -s https://api.nuget.org/v3/index.json
  Тогда пакет попадёт в кеш, и обычная сборка снова будет офлайновой.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
